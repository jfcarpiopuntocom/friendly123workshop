  "runner": "function stress(original,candidate){const load=s=>{const w={};new Function(\"window\",s)(w);return w.AMG.Cartera.calcularSaldo};const readers=[load(original),load(candidate)];const counts=[{pass:0,fail:0},{pass:0,fail:0}],failures=[[],[]],operations={new:0,alias:0,distinct:0,apply:0,undo:0};const cents=n=>Math.round(n*100);\n for(let seed=1;seed<=100;seed++){let rng=seed;const rnd=()=>{rng=(Math.imul(rng,1664525)+1013904223)>>>0;return rng};const client=\"synthetic\";const h=(id,tipo,datos,ts)=>({id,tipo,ts,datos:{clienteId:client,...datos}});const debt=100000,baseTime=1790000000000;const facts=[h(\"charge\",\"cartera_cargo\",{monto:debt/100,motivo:\"charge\"},baseTime)],payments=[],trace=[];let id=0;\n const add=(amount,nested)=>{const opId=\"payment-\"+(++id),fact=h(\"z-\"+opId,\"cartera_abono\",{monto:amount/100,motivo:\"payment\",opId},baseTime+1000);if(nested)fact.datos={payload:fact.datos};facts.push(fact);payments.push({opId,amount,applied:0,ids:[fact.id],payload:fact.datos.payload||fact.datos});};\n for(let step=0;step<100;step++){const time=baseTime+10000+step*1000,mode=payments.length?rnd()%5:0,pay=payments.length?payments[rnd()%payments.length]:null;let op;\n if(mode===0){let amount=1+rnd()%999;add(amount,!!(rnd()%2));op={type:\"new\",amount};}\n else if(mode===1){const alias=\"a-\"+(++id);let fact=h(alias,\"cartera_abono\",{...pay.payload},baseTime+1000);if(rnd()%2)fact.datos={payload:fact.datos};facts.push(fact);pay.ids.push(alias);op={type:\"alias\",opId:pay.opId,id:alias};}\n else if(mode===2){add(pay.amount,!!(rnd()%2));op={type:\"distinct\",amount:pay.amount};}\n else if(mode===3){const remaining=pay.amount-pay.applied;if(remaining>0){const n=1+rnd()%remaining,abonoId=pay.ids[rnd()%pay.ids.length];facts.push(h(\"allocation-\"+(++id),\"cartera_aplicacion\",{opId:\"alloc-\"+id,abonoId,accion:\"aplicar\",partes:[{cargoKey:\"cargo:charge\",monto:n/100}]},time));pay.applied+=n;op={type:\"apply\",opId:pay.opId,abonoId,n};}else{add(1,false);op={type:\"new\",amount:1};}}\n else {const abonoId=pay.ids[rnd()%pay.ids.length];facts.push(h(\"undo-\"+(++id),\"cartera_aplicacion\",{abonoId,accion:\"desaplicar\",cargoKey:\"cargo:charge\",monto:0},time));pay.applied=0;op={type:\"undo\",opId:pay.opId,abonoId};}\n operations[op.type]++;trace.push(op);\n const shuffled=facts.slice();for(let i=shuffled.length-1;i>0;i--){const j=rnd()%(i+1);[shuffled[i],shuffled[j]]=[shuffled[j],shuffled[i]]}const snap=JSON.stringify(shuffled);const credit=payments.reduce((a,p)=>a+p.amount,0),applied=payments.reduce((a,p)=>a+p.applied,0);const expected={saldo:credit-debt,applied,unassigned:credit-applied,count:payments.length,conflicts:0,immutable:true};\n for(let k=0;k<2;k++){const r=readers[k](shuffled,client,[]);const actual={saldo:cents(r.saldo),applied:cents(r.movimientos.filter(m=>m.tipo===\"cargo\").reduce((a,m)=>a+m.aplicado,0)),unassigned:cents(r.movimientos.filter(m=>m.tipo===\"abono\").reduce((a,m)=>a+m.sinAsignar,0)),count:r.movimientos.filter(m=>m.tipo===\"abono\").length,conflicts:r.conflictosAplicacion,immutable:snap===JSON.stringify(shuffled)};if(JSON.stringify(actual)===JSON.stringify(expected))counts[k].pass++;else{counts[k].fail++;if(failures[k].length<3)failures[k].push({seed,step,expected,actual,trace:trace.slice(),facts:shuffled});}}\n }\n }return {counts,operations,failures};}"
