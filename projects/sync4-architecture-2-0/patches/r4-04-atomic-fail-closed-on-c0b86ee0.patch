+test('multi-store transaction failure preserves pending op and never falls back to separate writes', async () => {
+  const { createTypedOpsIdbStore } = await import(STORE_URL);
+  const harness = makeTransactionalIdbHarness();
+  const store = createTypedOpsIdbStore({ indexedDB: harness.indexedDB, namespace: NS_A });
+  const entry = sampleEntry('opid_failure_12345');
+  await store.save(entry);
+  harness.rejectNextMultiTransaction();
+  await assert.rejects(() => store.save(entry), /Synthetic multi-store transaction failure/);
+  assert.equal((await store.loadAll()).length, 1);
+  assert.deepEqual(await store.loadCommittedOpIds(), []);
+  await store.markCommitted(entry.opId);
+  assert.equal((await store.loadAll()).length, 0);
+  assert.deepEqual(await store.loadCommittedOpIds(), [entry.opId]);
+});
