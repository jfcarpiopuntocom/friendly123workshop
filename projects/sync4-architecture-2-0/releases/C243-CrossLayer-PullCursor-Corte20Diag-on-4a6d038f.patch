@@ -0,0 +1,205 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const syncSrc = fs.readFileSync(path.join(__dirname, '../docs/sync-yjs.js'), 'utf8');
+
+function extractBlock(startMarker, endMarker) {
+  const start = syncSrc.indexOf(startMarker);
+  assert.ok(start >= 0, `missing start marker: ${startMarker}`);
+  const end = syncSrc.indexOf(endMarker, start);
+  assert.ok(end > start, `missing end marker: ${endMarker}`);
+  return syncSrc.slice(start, end);
+}
+
+test('RED->GREEN C243-1: switching relay layer (Cloudflare -> Firebase) with equal numeric (rev,seq) MUST still pull Firebase history', async () => {
+  // Real crearCanal slice from docs/sync-yjs.js covering cursor + pedirPagina + procesarHead
+  const cursorSlice = extractBlock('    var _pullCursorKey = "f123_yjs_pull_cursor_v2" + suffix;', '    function clavePendientes()');
+  const headSlice = extractBlock('    function pedirPagina(sock, estado, sinHead) {', '    function reprogramar()');
+  const ops = { pulls: [], persists: [] };
+  const idbStore = new Map();
+  const persistencia = {
+    db: {
+      objectStoreNames: { contains: () => true },
+      transaction() {
+        const tx = {};
+        queueMicrotask(() => tx.oncomplete && tx.oncomplete());
+        return tx;
+      }
+    },
+    whenSynced: Promise.resolve(),
+    async get(k) { return idbStore.has(k) ? JSON.parse(JSON.stringify(idbStore.get(k))) : undefined; },
+    async set(k, v) { idbStore.set(k, JSON.parse(JSON.stringify(v))); ops.persists.push(k); }
+  };
+
+  const fn = new Function('persistencia', 'Y', 'doc', 'canal', 'log', 'setTimeout', 'clearTimeout', 'ops', `
+    var suffix = "-ops", nombre = "ops", permiteCkpt = true;
+    var partesEntrantes = Object.create(null);
+    var _soloMemoria = false, _pendingProofPages = 0, _cursorContainsPending = false;
+    var _ultimoCursorLimpio = { rev: -1, seq: 0 };
+    var MAX_PENDING_PROOF_BYTES = 2 * 1024 * 1024;
+    var PULL_PAGE_SIZE = 64;
+    var _legacyProbeKey = "", _legacyProbeAttempts = 0, _tCkpt = null;
+    var _antecedentesBuscados = false, _replayUsed = 0;
+    var API = { _store: null };
+    function deudaPendiente() { return false; }
+    function programarRelectura() {}
+    function hacerCkpt() {}
+    ${cursorSlice}
+    function clavePendientes() { return "[]"; }
+    ${headSlice}
+    return {
+      pedirPagina,
+      procesarHead,
+      guardarPullCursor,
+      _pullCursorReady,
+      saveLayerCursor: typeof _guardarCursorCapa === "function" ? _guardarCursorCapa : null,
+      getCursor: sock => (typeof _cursorDeCapa === "function" ? _cursorDeCapa(sock) : _pullCursor)
+    };
+  `);
+
+  const doc = { store: null };
+  const Y = { encodeStateVector: () => new Uint8Array([0]) };
+  const canal = { ws: null, recuperando: true, headAcceso: false, accesoListo: () => false };
+  const ctx = fn(persistencia, Y, doc, canal, () => {}, setTimeout, clearTimeout, ops);
+  await ctx._pullCursorReady;
+
+  // Step 1: Cloudflare socket connects and pulls rev:1, seq:6
+  const wsCf = {
+    relayLayer: 'f123_relay_cupo_cf_v1',
+    readyState: 1,
+    send(raw) { ops.pulls.push({ layer: this.relayLayer, msg: JSON.parse(raw) }); }
+  };
+  canal.ws = wsCf;
+  const estCf = { esperandoHead: true, enCurso: true, pullAplicado: false };
+  await ctx.procesarHead(wsCf, estCf, { rev: 1, seq: 6 });
+  // Simulate CF pull-page completion advancing cursor to rev:1, seq:6
+  await ctx.guardarPullCursor({ rev: 1, seq: 6 });
+  if (ctx.saveLayerCursor) await ctx.saveLayerCursor(wsCf, { rev: 1, seq: 6 });
+
+  // Step 2: Switch to Firebase whose independent head ALSO happens to be { rev: 1, seq: 6 }
+  ops.pulls.length = 0;
+  const wsFb = {
+    relayLayer: 'f123_relay_cupo_fb_v1',
+    readyState: 1,
+    send(raw) { ops.pulls.push({ layer: this.relayLayer, msg: JSON.parse(raw) }); }
+  };
+  canal.ws = wsFb;
+  const estFb = { esperandoHead: true, enCurso: true, pullAplicado: false };
+  await ctx.procesarHead(wsFb, estFb, { rev: 1, seq: 6 });
+
+  const fbPulls = ops.pulls.filter(p => p.layer === 'f123_relay_cupo_fb_v1' && p.msg.k === 'pull');
+  assert.equal(fbPulls.length, 1, 'Firebase must request pull from -1:0 even when CF already reached 1:6');
+  assert.deepEqual({ rev: fbPulls[0].msg.rev, seq: fbPulls[0].msg.seq }, { rev: -1, seq: 0 });
+});
+
+test('RED->GREEN C243-2: _intentarActivarCorte20SiElegible exposes zero-PII diagnostic failure reason instead of silent swallow', async () => {
+  const snippet = extractBlock('    function _intentarActivarCorte20SiElegible() {', '    API.estado = "activo";');
+  const API = {
+    canal: { reanudar() {}, pausar() {} },
+    fotosCanal: { reanudar() {}, pausar() {} },
+    opsCanal: { reanudar() {}, pausar() {} },
+    canalSombra: null,
+    canalPiloto: { tipo: 'piloto' },
+    catalogoPublicoLector: null,
+    coordinadorCorte20: null,
+    modoCorte20Activo: false,
+    rollout: { yparty: true, frozenHead: 'fb-deadbeef' },
+    idb: { synced: true },
+    opsIdb: { synced: true },
+    doc: { isDestroyed: false, store: null },
+    codigoCuaderno: 'F123-TEST-1234',
+    async activarCorte20Runtime() {
+      throw new Error('certified baseline mismatch');
+    }
+  };
+  const fn = new Function(
+    'API', 'document', 'window', 'localStorage', 'timerRetorno', 'retornoEnCurso',
+    'canalesPiloto', 'programarRetorno', 'clearTimeout', 'setTimeout',
+    snippet.replace(/\n    API\.canal\.conectar\(\);[\s\S]*?(?=\n    API\.corte20QaHabilitado =)/m, '') +
+    '\nreturn { intentar: _intentarActivarCorte20SiElegible };'
+  );
+  const win = {
+    addEventListener() {},
+    OCAuth: { esDemo: () => false, rolActual: () => 'dueno' },
+    OCSyncControl: {
+      async pausarParaArquitectura20() { return { ok: true }; },
+      reanudarDesdeArquitectura20() {}
+    }
+  };
+  const res = fn(API, { hidden: false, addEventListener() {} }, win, { getItem: () => null }, null, false, [], () => {}, clearTimeout, setTimeout);
+  await res.intentar();
+  await new Promise(r => setTimeout(r, 30));
+
+  assert.equal(API.modoCorte20Activo, false);
+  assert.ok(API.__ultimoEstadoCorte20 && API.__ultimoEstadoCorte20.activo === false &&
+    typeof API.__ultimoEstadoCorte20.motivo === 'string' && API.__ultimoEstadoCorte20.motivo.length > 0,
+    'expected non-empty diagnostic reason when 2.0 cutover fails silently');
+});
+
+test('RED->GREEN C243-3: per-layer cursors persist cleanly across reload in IDB :capas store', async () => {
+  const cursorSlice = extractBlock('    var _pullCursorKey = "f123_yjs_pull_cursor_v2" + suffix;', '    function clavePendientes()');
+  const headSlice = extractBlock('    function pedirPagina(sock, estado, sinHead) {', '    function reprogramar()');
+  const idbStore = new Map();
+  const makePersistencia = () => ({
+    db: {
+      objectStoreNames: { contains: () => true },
+      transaction() {
+        const tx = {};
+        queueMicrotask(() => tx.oncomplete && tx.oncomplete());
+        return tx;
+      }
+    },
+    whenSynced: Promise.resolve(),
+    async get(k) { return idbStore.has(k) ? JSON.parse(JSON.stringify(idbStore.get(k))) : undefined; },
+    async set(k, v) { idbStore.set(k, JSON.parse(JSON.stringify(v))); }
+  });
+  function mount() {
+    const pulls = [];
+    const fn = new Function('persistencia', 'Y', 'doc', 'canal', 'log', 'setTimeout', 'clearTimeout', `
+      var suffix = "-y", nombre = "catalogo", permiteCkpt = true;
+      var partesEntrantes = Object.create(null);
+      var _soloMemoria = false, _pendingProofPages = 0, _cursorContainsPending = false;
+      var _ultimoCursorLimpio = { rev: -1, seq: 0 };
+      var MAX_PENDING_PROOF_BYTES = 2 * 1024 * 1024;
+      var PULL_PAGE_SIZE = 64;
+      var _legacyProbeKey = "", _legacyProbeAttempts = 0, _tCkpt = null;
+      var _antecedentesBuscados = false, _replayUsed = 0;
+      var API = { _store: null };
+      function deudaPendiente() { return false; }
+      function programarRelectura() {}
+      function hacerCkpt() {}
+      ${cursorSlice}
+      function clavePendientes() { return "[]"; }
+      ${headSlice}
+      return {
+        pedirPagina, procesarHead, guardarPullCursor, _pullCursorReady,
+        saveLayerCursor: _guardarCursorCapa, hydrateLayers: _hidratarCursoresCapa,
+        getCursor: _cursorDeCapa
+      };
+    `);
+    const doc = { store: null }, Y = { encodeStateVector: () => new Uint8Array([0]) };
+    const canal = { ws: null, recuperando: true, headAcceso: false, accesoListo: () => false };
+    return { ctx: fn(makePersistencia(), Y, doc, canal, () => {}, setTimeout, clearTimeout), canal, pulls };
+  }
+
+  // Session 1: CF -> 2:10, FB -> 1:500
+  const s1 = mount();
+  await s1.ctx._pullCursorReady;
+  const wsCf = { relayLayer: 'f123_relay_cupo_cf_v1', readyState: 1, send: r => s1.pulls.push(['cf', JSON.parse(r)]) };
+  s1.canal.ws = wsCf;
+  await s1.ctx.saveLayerCursor(wsCf, { rev: 2, seq: 10 });
+  const wsFb = { relayLayer: 'f123_relay_cupo_fb_v1', readyState: 1, send: r => s1.pulls.push(['fb', JSON.parse(r)]) };
+  s1.canal.ws = wsFb;
+  await s1.ctx.saveLayerCursor(wsFb, { rev: 1, seq: 500 });
+
+  // Session 2 (cold reload): hydrates independent cursors for CF (2:10) and FB (1:500)
+  const s2 = mount();
+  await s2.ctx._pullCursorReady;
+  await s2.ctx.hydrateLayers();
+  assert.deepEqual(s2.ctx.getCursor({ relayLayer: 'f123_relay_cupo_cf_v1' }), { rev: 2, seq: 10 });
+  assert.deepEqual(s2.ctx.getCursor({ relayLayer: 'f123_relay_cupo_fb_v1' }), { rev: 1, seq: 500 });
+});
